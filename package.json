{
  "name": "whoiseno",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpx @biomejs/biome lint",
    "lint:fix": "pnpx @biomejs/biome lint --write",
    "format": "pnpx @biomejs/biome format --write",
    "check": "pnpx @biomejs/biome check --write",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^6.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,vue}": [
      "pnpm run format",
      "pnpm run lint:fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
