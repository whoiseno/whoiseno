---
import { Text } from "@/shared/ui/text";
import { getCollection } from "astro:content";

import UsesItem from "./UsesItem.astro";

const software = (await getCollection("software")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

{software.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <ul class="flex flex-col gap-2xs">
    {software.map(({ data }) => (
      <li>
        <UsesItem {...data} />
      </li>
    ))}
  </ul>
)}
