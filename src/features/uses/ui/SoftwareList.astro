---
import { getCollection } from "astro:content";

import UsesItem from "./UsesItem.astro";

const software = (await getCollection("software")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

{software.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <ul class="flex flex-col gap-2">
    {software.map(({ data }) => (
      <li>
        <UsesItem {...data} />
      </li>
    ))}
  </ul>
)}
