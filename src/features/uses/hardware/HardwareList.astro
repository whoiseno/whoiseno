---
import Card from "@/shared/ui/card/Card.astro";
import { getCollection } from "astro:content";

const hardware = (await getCollection("hardware")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

{hardware.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <ul class="space-y-3">
    {hardware.map(({ data }) => (
      <li>
        <Card href={data.link ?? undefined}>
          <h3 class="font-medium">{data.name}</h3>
          {data.description && <p class="text-muted-foreground">{data.description}</p>}
        </Card>
      </li>
    ))}
  </ul>
)}
