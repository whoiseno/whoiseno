---
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
import { Tooltip, TooltipContent, TooltipTrigger } from "@/shared/ui/tooltip";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Tooltip class={className}>
  <TooltipTrigger>
    <Button
      aria-label="Scroll to top"
      color="neutral"
      disabled
      size="md"
      type="button"
      variant="ghost"
      x-bind:disabled="!scrolled"
      x-data="scrollToTop"
      x-on:click="top()"
      x-on:scroll.window.passive="update()"
    >
      <Icon
        class="size-4"
        name="reicon:ArrowUp"
      />
    </Button>
  </TooltipTrigger>
  <TooltipContent>Scroll back to the top of the page</TooltipContent>
</Tooltip>
