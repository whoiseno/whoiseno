---
import { Button } from "@/shared/ui/button";
import Icon from "@/shared/ui/icon/Icon.astro";
---

<div
  class="relative"
  data-slot="carousel"
  aria-roledescription="carousel"
  role="group"
  x-data="carousel"
  x-on:resize.window="update()"
>
  <div
    class="flex snap-x snap-mandatory items-start gap-3 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-slot="carousel-track"
    aria-label="Slides"
    role="region"
    tabindex="0"
    x-on:scroll.passive="update()"
    x-ref="track"
  >
    <slot />
  </div>
  <Button
    class="absolute top-1/2 left-2 -translate-y-1/2 rounded-full bg-background/80 backdrop-blur"
    aria-label="Previous slide"
    color="neutral"
    disabled
    size="sm"
    type="button"
    variant="outline"
    x-bind:disabled="!canPrev"
    x-on:click="go(-1)"
  >
    <Icon
      class="size-4"
      name="reicon:ArrowLeft"
    />
  </Button>
  <Button
    class="absolute top-1/2 right-2 -translate-y-1/2 rounded-full bg-background/80 backdrop-blur"
    aria-label="Next slide"
    color="neutral"
    size="sm"
    type="button"
    variant="outline"
    x-bind:disabled="!canNext"
    x-on:click="go(1)"
  >
    <Icon
      class="size-4"
      name="reicon:ArrowRight"
    />
  </Button>
</div>
