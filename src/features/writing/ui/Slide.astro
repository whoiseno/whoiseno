---
import { aspectRatioCatalog, type TypeAspectRatioName } from "@/shared/config/aspect-ratio";
import { cn } from "@/shared/lib/tailwind";
import { CarouselItem } from "@/shared/ui/carousel";

interface Props {
  ratio?: TypeAspectRatioName;
}

const { ratio = "original" } = Astro.props;
const value = aspectRatioCatalog[ratio].ratio;
---

<CarouselItem
  class={cn(
    "w-4/5 space-y-2xs [&_[data-slot=figure-image]]:w-full [&_[data-slot=lightbox-trigger]]:w-full",
    value && "[&_[data-slot=figure-image]]:aspect-(--ratio) [&_[data-slot=figure-image]]:object-cover",
  )}
  style={{ "--ratio": value ?? undefined }}
>
  <slot />
</CarouselItem>
