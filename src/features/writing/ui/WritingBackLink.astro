---
import { Icon } from "@/shared/ui/icon";

interface Props {
  class?: string;
  href?: string;
  label?: string;
}

const { class: className, href = "/writing", label = "All writing" } = Astro.props;
---

<a
  class:list={[
    "inline-flex items-center gap-3xs text-muted-foreground transition-colors hover:text-foreground",
    className,
  ]}
  data-slot="writing-back-link"
  href={href}
>
  <Icon
    class="size-3.5"
    name="reicon:ArrowLeft"
  />
  {label}
</a>
