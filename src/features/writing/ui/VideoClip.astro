---
import { isCloudAsset, type TypeCloudAsset } from "@/shared/lib/cloud-asset";
import { Text } from "@/shared/ui/text";

interface Props {
  /** A file uploaded in the CMS to Cloudinary, or a path under `public/` for one saved there earlier. */
  file?: TypeCloudAsset | string;
  /** A direct link to a video file. Used when there is no uploaded `file`. */
  url?: string;
  caption?: string;
}

const { file, url, caption } = Astro.props;
const src = (isCloudAsset(file) ? file.url : file) || url;
if (!src) throw new Error("A video needs a file or a url.");
---

<figure
  class="space-y-2xs"
  data-slot="video"
>
  <video
    class="w-full rounded-lg border bg-muted"
    aria-label={caption || "Video"}
    controls
    playsinline
    preload="metadata"
    src={src}
  >
    Your browser cannot play this video. <a href={src}>Download it</a>.
  </video>
  {caption && (
    <Text
      as="figcaption"
      tone="muted"
      variant="small"
    >
      {caption}
    </Text>
  )}
</figure>
