---
import type { MarkdownHeading } from "astro";

import WritingBackLink from "./WritingBackLink.astro";

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<aside
  class="absolute top-0 right-[calc(100%+var(--breakout))] bottom-0 hidden w-[min(10rem,calc((100vw-100%)/2-var(--breakout)-1rem))] pr-6 lg:block"
  data-slot="writing-toc"
  data-focus-hide
>
  <div class="sticky top-24 max-h-[calc(100vh-8rem)] space-y-4 overflow-y-auto">
    <WritingBackLink class="text-xs" />
    {items.length > 0 && (
      <nav aria-label="Table of contents">
        <p class="mb-2 text-xs font-medium">On this page</p>
        <ul class="space-y-1 border-l text-xs">
          {items.map((item) => (
            <li>
              <a
                class:list={[
                  "-ml-px block border-l border-transparent py-0.5 text-muted-foreground transition-colors hover:text-foreground data-[active=true]:border-brand data-[active=true]:font-medium data-[active=true]:text-brand",
                  item.depth === 3 ? "pl-5" : "pl-3",
                ]}
                href={`#${item.slug}`}
                x-bind:aria-current={`active === '${item.slug}' ? 'location' : false`}
                x-bind:data-active={`active === '${item.slug}'`}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</aside>
