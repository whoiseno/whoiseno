---
import type { MarkdownHeading } from "astro";

import { Toc, TocContent, TocItem, TocTick, TocTicks } from "./toc";

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth <= 3);
---

{items.length > 0 && (
  <Toc>
    <TocTicks>
      {items.map((item) => (
        <TocTick
          depth={item.depth}
          slug={item.slug}
        />
      ))}
    </TocTicks>
    <TocContent>
      {items.map((item) => (
        <TocItem
          depth={item.depth}
          slug={item.slug}
        >
          {item.text}
        </TocItem>
      ))}
    </TocContent>
  </Toc>
)}
