---
interface Props {
  id: string;
  /** Counted in reference order by the Markdoc `document` node. */
  number: number;
}

const { id, number } = Astro.props;
---

<div
  id={`fn-${id}`}
  aria-label={`Footnote ${number}`}
  data-footnote={id}
  data-slot="footnote"
  role="note"
>
  <a
    aria-label={`Back to footnote ${number} in the text`}
    data-slot="footnote-marker"
    href={`#fnref-${id}`}
  >
    {number}
  </a>
  <div data-slot="footnote-body">
    <slot />
  </div>
</div>
