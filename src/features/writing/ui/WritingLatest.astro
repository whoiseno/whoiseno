---
import { Text } from "@/shared/ui/text";
import { getCollection } from "astro:content";

import WritingListItem from "./WritingListItem.astro";

interface Props {
  /** How many of the newest entries to show. */
  limit?: number;
}

const { limit } = Astro.props;

const entries = (await getCollection("writing"))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, limit);
---

{entries.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <ul
    class="group/writing [&>li+li]:border-t"
    data-slot="writing-latest"
  >
    {entries.map((entry) => (
      <WritingListItem entry={entry} />
    ))}
  </ul>
)}
