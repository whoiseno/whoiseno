---
import { formatDate } from "@/shared/lib/date";
import { slugify } from "@/shared/lib/slug";
import { Badge } from "@/shared/ui/badge";
import { Text } from "@/shared/ui/text";
import { getCollection } from "astro:content";

import { writingKindLabels } from "../config/kinds";
import { getReadingMinutes } from "../model/reading-time";

interface Props {
  tag?: string;
  /** Shows only the latest entries. */
  limit?: number;
  /** Follows the kind filter of the writing page. Turn off where there is no filter, such as the home page. */
  filterable?: boolean;
}

const { tag, limit, filterable = true } = Astro.props;

const entries = (await getCollection("writing"))
  .filter(({ data }) => !tag || data.tags.some((label) => slugify(label) === tag))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, limit);

const years = new Map<number, typeof entries>();
for (const entry of entries) {
  const year = entry.data.publishedDate.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), entry]);
}

const counts: Record<string, number> = {};
for (const { data } of entries) counts[data.kind] = (counts[data.kind] ?? 0) + 1;
---

{entries.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <div
    class="group/writing space-y-xl"
    data-slot="writing-list"
    x-data={filterable ? `{ counts: ${JSON.stringify(counts)} }` : undefined}
  >
    {[...years].map(([year, items]) => (
      <section class="space-y-2xs [&:not(:has(li:not([hidden])))]:hidden">
        <Text
          as="h2"
          tone="muted"
          variant="mono"
        >
          {year}
        </Text>
        <ul class="[&>li:not([hidden])~li:not([hidden])]:border-t">
          {items.map(({ id, data, body }) => (
            <li x-bind:hidden={filterable ? `!$store.writingFilter.shows('${data.kind}')` : undefined}>
              <a
                class="flex flex-wrap items-baseline justify-between gap-x-s gap-y-3xs py-s transition-[filter,opacity] duration-200 [@media(hover:hover)]:group-has-[a:hover]/writing:not-hover:opacity-60 [@media(hover:hover)]:group-has-[a:hover]/writing:not-hover:blur-[1.5px]"
                href={`/writing/${id}`}
              >
                <Text
                  as="span"
                  class="min-w-0 flex-[1_1_12rem] truncate"
                  variant="label"
                >
                  {data.title}
                </Text>
                <span class="flex shrink-0 items-center gap-2xs">
                  <Badge>{writingKindLabels[data.kind]}</Badge>
                  <Text
                    as="span"
                    class="uppercase"
                    tone="muted"
                    variant="mono"
                  >
                    {getReadingMinutes(body)} min read
                  </Text>
                  <Text
                    as="time"
                    class="uppercase"
                    datetime={data.publishedDate.toISOString()}
                    tone="muted"
                    variant="mono"
                  >
                    {formatDate(data.publishedDate)}
                  </Text>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {filterable && (
      <Text
        tone="muted"
        x-cloak
        x-show="$store.writingFilter.kind !== 'all' && !counts[$store.writingFilter.kind]"
      >
        Nothing of this kind yet.
      </Text>
    )}
  </div>
)}
