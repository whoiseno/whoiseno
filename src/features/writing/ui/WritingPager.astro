---
import { Card } from "@/shared/ui/card";
import { Icon } from "@/shared/ui/icon";
import { Text } from "@/shared/ui/text";

interface TypePagerEntry {
  id: string;
  title: string;
}

interface Props {
  /** The post published just before this one. */
  previous?: TypePagerEntry | null;
  /** The post published just after this one. */
  next?: TypePagerEntry | null;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav
    class="grid-fluid gap-xs [--grid-fill:auto-fit] [--grid-min:16rem]"
    aria-label="Previous and next posts"
    data-slot="writing-pager"
  >
    {previous && (
      <Card href={`/writing/${previous.id}`}>
        <Text
          as="span"
          class="flex items-center gap-3xs"
          tone="muted"
          variant="small"
        >
          <Icon
            class="size-3.5"
            name="reicon:ArrowLeft"
          />
          Previous
        </Text>
        <Text
          as="span"
          class="mt-3xs block truncate"
          variant="label"
        >
          {previous.title}
        </Text>
      </Card>
    )}
    {next && (
      <Card
        class="text-right"
        href={`/writing/${next.id}`}
      >
        <Text
          as="span"
          class="flex items-center justify-end gap-3xs"
          tone="muted"
          variant="small"
        >
          Next
          <Icon
            class="size-3.5"
            name="reicon:ArrowRight"
          />
        </Text>
        <Text
          as="span"
          class="mt-3xs block truncate"
          variant="label"
        >
          {next.title}
        </Text>
      </Card>
    )}
  </nav>
)}
