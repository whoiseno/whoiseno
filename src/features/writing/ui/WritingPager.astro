---
import WritingPagerLink from "./WritingPagerLink.astro";

interface TypePagerEntry {
  href: string;
  title: string;
}

interface Props {
  /** The entry just before this one. */
  previous?: TypePagerEntry | null;
  /** The entry just after this one. */
  next?: TypePagerEntry | null;
  /** Names the navigation for screen readers. */
  label?: string;
}

const { previous, next, label = "Previous and next posts" } = Astro.props;
---

{(previous || next) && (
  <nav
    class="grid-fluid gap-xs [--grid-fill:auto-fit] [--grid-min:16rem]"
    aria-label={label}
    data-slot="writing-pager"
  >
    {previous && (
      <WritingPagerLink
        direction="previous"
        href={previous.href}
        title={previous.title}
      />
    )}
    {next && (
      <WritingPagerLink
        direction="next"
        href={next.href}
        title={next.title}
      />
    )}
  </nav>
)}
