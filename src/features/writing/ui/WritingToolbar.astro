---
import { cn } from "@/shared/lib/tailwind";

import WritingFocusToggle from "./WritingFocusToggle.astro";
import WritingWideToggle from "./WritingWideToggle.astro";

interface Props {
  size?: "icon-sm" | "icon-md";
  class?: string;
}

const { size = "icon-sm", class: className } = Astro.props;
---

<div
  class={cn("flex items-center gap-3xs", className)}
  data-slot="writing-toolbar"
>
  <WritingWideToggle size={size} />
  <WritingFocusToggle size={size} />
</div>
