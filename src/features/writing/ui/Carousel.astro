---
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure
  class="@container [--carousel-span:100cqw]"
  data-slot="carousel"
  aria-roledescription="carousel"
  x-data="carousel"
  x-on:resize.window="update()"
>
  <div
    class="-ml-[calc((var(--carousel-span)-100cqw)/2)] flex w-(--carousel-span) scroll-pl-[calc((var(--carousel-span)-100cqw)/2)] snap-x snap-mandatory items-start gap-3 overflow-x-auto px-[calc((var(--carousel-span)-100cqw)/2)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-slot="carousel-track"
    aria-label="Slides"
    role="region"
    tabindex="0"
    x-on:scroll.passive="update()"
    x-ref="track"
  >
    <slot />
  </div>
  <div class="mt-3 flex items-center gap-3">
    <div class="flex shrink-0 gap-2">
      <Button
        class="rounded-full"
        aria-label="Previous slide"
        color="neutral"
        disabled
        size="sm"
        type="button"
        variant="outline"
        x-bind:disabled="!canPrev"
        x-on:click="go(-1)"
      >
        <Icon
          class="size-4"
          name="reicon:ArrowLeft"
        />
      </Button>
      <Button
        class="rounded-full"
        aria-label="Next slide"
        color="neutral"
        size="sm"
        type="button"
        variant="outline"
        x-bind:disabled="!canNext"
        x-on:click="go(1)"
      >
        <Icon
          class="size-4"
          name="reicon:ArrowRight"
        />
      </Button>
    </div>
    {caption && <figcaption class="text-xs text-muted-foreground">{caption}</figcaption>}
  </div>
</figure>
