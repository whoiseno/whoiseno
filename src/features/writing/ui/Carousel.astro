---
import { Carousel, CarouselContent, CarouselNext, CarouselPrevious } from "@/shared/ui/carousel";
import { Text } from "@/shared/ui/text";

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<Carousel class="@container relative z-10">
  <div class="mb-xs flex items-center gap-xs">
    {caption && (
      <Text
        as="figcaption"
        class="min-w-0"
        tone="muted"
        variant="small"
      >
        {caption}
      </Text>
    )}
    <div class="ml-auto flex shrink-0 gap-2xs">
      <CarouselPrevious />
      <CarouselNext />
    </div>
  </div>
  <CarouselContent class="-ml-[calc((var(--page-width)-100cqw)/2)] w-(--page-width) scroll-pl-[calc((var(--page-width)-100cqw)/2)] px-[calc((var(--page-width)-100cqw)/2)]">
    <slot />
  </CarouselContent>
</Carousel>
