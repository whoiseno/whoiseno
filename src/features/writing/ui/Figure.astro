---
import { cloudImageUrl, isCloudAsset, type TypeImageSource } from "@/shared/lib/cloud-asset";
import { AssetImage } from "@/shared/ui/asset-image";
import {
  Lightbox,
  LightboxCaption,
  LightboxClose,
  LightboxContent,
  LightboxImage,
  LightboxTrigger,
} from "@/shared/ui/lightbox";
import { Text } from "@/shared/ui/text";
import { getImage } from "astro:assets";

interface Props {
  src: TypeImageSource | string;
  alt?: string;
  title?: string;
  /** Load eagerly with high fetch priority, for an image visible on first paint. */
  priority?: boolean;
}

const { src, alt = "", title, priority = false } = Astro.props;
// Optimised variant, capped so a large original is never sent to the dialog.
const full =
  typeof src === "string"
    ? src
    : isCloudAsset(src)
      ? cloudImageUrl(src.url, { width: Math.min(src.width ?? 2000, 2000) })
      : (await getImage({ src, width: Math.min(src.width, 2000) })).src;
// The browser picks a file by the width of the text column. An upload is resized by Cloudinary, an import is not.
const responsive = isCloudAsset(src)
  ? { widths: [640, 960, 1280, 1600], sizes: "(min-width: 80rem) 52rem, 100vw" }
  : {};
---

<figure
  class="space-y-2xs"
  data-slot="figure"
>
  <Lightbox>
    <LightboxTrigger aria-label={alt ? `Enlarge image: ${alt}` : "Enlarge image"}>
      {typeof src === "string" ? (
        <img
          class="rounded-lg border"
          alt={alt}
          data-slot="figure-image"
          fetchpriority={priority ? "high" : undefined}
          loading={priority ? "eager" : "lazy"}
          src={src}
        />
      ) : (
        <AssetImage
          {...responsive}
          class="rounded-lg border"
          alt={alt}
          data-slot="figure-image"
          fetchpriority={priority ? "high" : undefined}
          loading={priority ? "eager" : "lazy"}
          src={src}
        />
      )}
    </LightboxTrigger>
    <LightboxContent label={alt || title}>
      <LightboxImage
        alt={alt}
        src={full}
      />
      {title && <LightboxCaption>{title}</LightboxCaption>}
      <LightboxClose />
    </LightboxContent>
  </Lightbox>
  {title && (
    <Text
      as="figcaption"
      tone="muted"
      variant="small"
    >
      {title}
    </Text>
  )}
</figure>
