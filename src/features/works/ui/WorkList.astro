---
import { logoCatalog } from "@/shared/config/logos";
import { formatDateRange } from "@/shared/lib/date";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "@/shared/ui/accordion";
import { Badge } from "@/shared/ui/badge";
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
import { Prose } from "@/shared/ui/prose";
import { getCollection, render } from "astro:content";

interface Props {
  /** Shows only the latest works, followed by a link to the full list. */
  limit?: number;
}

const workModes = { "on-site": "On-Site", "remote": "Remote", "hybrid": "Hybrid" } as const;

const { limit } = Astro.props;
const allWorks = (await getCollection("works")).sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const works = allWorks.slice(0, limit);
const hasMore = works.length < allWorks.length;
const items = await Promise.all(works.map(async (work) => ({ work, Content: (await render(work)).Content })));
const current = items.find(({ work }) => !work.data.endDate)?.work.id;
---

{items.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <div class="space-y-6">
    <Accordion
      class="divide-y"
      defaultValue={current}
      type="single"
    >
      {items.map(({ work, Content }) => {
        const { company, role, location, workMode, startDate, endDate, link, technologies } = work.data;
        const mode = workModes[workMode];
        return (
          <AccordionItem
            class="py-4 first:pt-0 last:pb-0"
            value={work.id}
          >
            <AccordionTrigger
              class="group/trigger"
              chevron={false}
            >
              <span class="min-w-0 space-y-0.5">
                <span class="flex items-center gap-2">
                  <span class="font-medium">{company}</span>
                  {!endDate && <Badge variant="success">Working</Badge>}
                  <Icon
                    class="size-4 shrink-0 text-muted-foreground transition-all duration-200 pointer-fine:opacity-0 pointer-fine:group-hover/trigger:opacity-100 pointer-fine:group-focus-visible/trigger:opacity-100 group-data-[state=open]/accordion-item:rotate-180 group-data-[state=open]/accordion-item:opacity-100"
                    name="reicon:ChevronDown"
                  />
                </span>
                <span class="block text-muted-foreground">{role}</span>
              </span>
              <span class="shrink-0 text-right text-xs text-muted-foreground">
                <span class="block sm:hidden">{formatDateRange(startDate, endDate)}</span>
                <span class="hidden sm:block">{formatDateRange(startDate, endDate, "long")}</span>
                <span class="block sm:hidden">{mode}</span>
                <span class="hidden sm:block">{location ? `${location} (${mode})` : mode}</span>
              </span>
            </AccordionTrigger>
            <AccordionContent>
              <div class="space-y-4 border-t pt-4">
                {technologies.length > 0 && (
                  <div class="space-y-2">
                    <h4 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
                      Technologies & Tools
                    </h4>
                    <ul class="flex flex-wrap gap-2">
                      {technologies.map((name) => (
                        <li>
                          <span
                            class="flex size-10 items-center justify-center rounded-lg border bg-card"
                            title={logoCatalog[name].label}
                          >
                            <Icon
                              class="size-5"
                              name={`logo:${name}`}
                            />
                            <span class="sr-only">{logoCatalog[name].label}</span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <div class="space-y-2">
                  <h4 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">What I've done</h4>
                  <Prose>
                    <Content />
                  </Prose>
                </div>
                {link && (
                  <a
                    class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-foreground"
                    href={link}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Visit {company}
                    <Icon
                      class="size-3.5"
                      name="reicon:ArrowUpRight"
                    />
                  </a>
                )}
              </div>
            </AccordionContent>
          </AccordionItem>
        );
      })}
    </Accordion>
    {hasMore && (
      <div class="flex justify-center">
        <Button
          color="neutral"
          href="/works"
          size="md"
          variant="outline"
        >
          Show all work experiences
        </Button>
      </div>
    )}
  </div>
)}
