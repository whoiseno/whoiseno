---
import { Accordion } from "@/shared/ui/accordion";
import { Button } from "@/shared/ui/button";
import { Text } from "@/shared/ui/text";
import { getCollection } from "astro:content";

import WorkItem from "./WorkItem.astro";

interface Props {
  /** Shows only the latest works, followed by a link to the full list. */
  limit?: number;
}

const { limit } = Astro.props;
const allWorks = (await getCollection("works")).sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const works = allWorks.slice(0, limit);
const hasMore = works.length < allWorks.length;
const current = works.find((work) => !work.data.endDate)?.id;
---

{works.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <div class="space-y-m">
    <Accordion
      class="divide-y"
      defaultValue={current}
      type="single"
    >
      {works.map((work) => (
        <WorkItem work={work} />
      ))}
    </Accordion>
    {hasMore && (
      <div class="flex justify-center">
        <Button
          color="neutral"
          href="/works"
          size="md"
          variant="outline"
        >
          Show all work experiences
        </Button>
      </div>
    )}
  </div>
)}
