---
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
---

<Button
  aria-label="Toggle theme"
  color="neutral"
  size="md"
  type="button"
  variant="ghost"
  x-data="themeToggle"
  x-on:click="toggle()"
>
  <Icon
    class="hidden size-4 dark:block"
    name="reicon:Sun"
  />
  <Icon
    class="size-4 dark:hidden"
    name="reicon:Moon"
  />
</Button>
