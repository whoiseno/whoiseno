---
import { Badge } from "@/shared/ui/badge";
import { Card, CardAction, CardContent, CardHeader, CardTitle } from "@/shared/ui/card";
import Rating from "@/shared/ui/rating/Rating.astro";
import { getCollection } from "astro:content";

const statuses = [
  { value: "watching", label: "Watching" },
  { value: "watched", label: "Watched" },
  { value: "planned", label: "Planned" },
] as const;

const kinds = { movie: "Movie", show: "Show", anime: "Anime" } as const;

const movies = await getCollection("movies");
const groups = statuses
  .map(({ value, label }) => ({
    label,
    movies: movies.filter(({ data }) => data.status === value).sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }))
  .filter((group) => group.movies.length > 0);
---

{groups.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  groups.map((group) => (
    <section class="space-y-3">
      <h2 class="font-serif text-xl font-semibold">{group.label}</h2>
      <ul class="space-y-3">
        {group.movies.map(({ data }) => (
          <li>
            <Card
              class="space-y-1"
              href={data.link ?? undefined}
            >
              <CardHeader>
                <div class="space-y-1">
                  <CardTitle>{data.title}</CardTitle>
                  <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <Badge>{kinds[data.kind]}</Badge>
                    {data.year && <span>{data.year}</span>}
                  </div>
                </div>
                {data.rating && (
                  <CardAction>
                    <Rating value={data.rating} />
                  </CardAction>
                )}
              </CardHeader>
              {data.note && <CardContent class="text-muted-foreground">{data.note}</CardContent>}
            </Card>
          </li>
        ))}
      </ul>
    </section>
  ))
)}
