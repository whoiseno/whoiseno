---
import { resolvePoster } from "@/shared/api/posters";
import { resolveMediaLink } from "@/shared/config/media-sources";
import { formatMonthYear } from "@/shared/lib/date";
import { MediaItem } from "@/shared/ui/media-item";
import { Text } from "@/shared/ui/text";
import { getCollection, type CollectionEntry } from "astro:content";

const kinds = { movie: "Movie", series: "Series", show: "Show", anime: "Anime" } as const;
const order = { watching: 0, watched: 1, planned: 2 } as const;

const entries = await Promise.all(
  (await getCollection("movies")).map(async (entry) => ({
    ...entry,
    poster: entry.data.poster ?? (await resolvePoster(entry.data.links)),
  })),
);
const movies = entries.sort(
  (a, b) =>
    order[a.data.status] - order[b.data.status] ||
    (b.data.watchedDate?.getTime() ?? 0) - (a.data.watchedDate?.getTime() ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);
const watching = movies.filter(({ data }) => data.status === "watching");
const library = movies.filter(({ data }) => data.status !== "watching");

function timeline({ status, startedDate, watchedDate }: CollectionEntry<"movies">["data"]) {
  if (status === "planned") return "Planned";
  if (status === "watching") return startedDate ? `Started ${formatMonthYear(startedDate)}` : "Watching";
  return watchedDate ? `Watched ${formatMonthYear(watchedDate)}` : undefined;
}
---

{movies.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <>
    {watching.length > 0 && (
      <section class="space-y-s-m">
        <Text variant="heading">Watching</Text>
        <ul class="space-y-m">
          {watching.map(({ data, poster }) => (
            <li>
              <MediaItem
                badge={kinds[data.kind]}
                byline={data.creator}
                description={data.description}
                layout="row"
                links={data.links.map(({ source, id }) => resolveMediaLink(source, id))}
                poster={poster}
                posterRatio={data.posterRatio}
                published={data.releaseDate}
                rating={data.rating}
                timeline={timeline(data)}
                title={data.title}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    {library.length > 0 && (
      <section class="space-y-s-m">
        <Text variant="heading">Library</Text>
        <ul class="grid-fluid items-start gap-x-s gap-y-l [--grid-min:9.5rem]">
          {library.map(({ data, poster }) => (
            <li>
              <MediaItem
                badge={kinds[data.kind]}
                byline={data.creator}
                description={data.description}
                links={data.links.map(({ source, id }) => resolveMediaLink(source, id))}
                poster={poster}
                posterRatio={data.posterRatio}
                published={data.releaseDate}
                rating={data.rating}
                timeline={timeline(data)}
                title={data.title}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </>
)}
