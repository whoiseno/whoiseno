---
import { formatMonthYear } from "@/shared/lib/date";
import { Card, CardAction, CardContent, CardDescription, CardHeader, CardTitle } from "@/shared/ui/card";
import Rating from "@/shared/ui/rating/Rating.astro";
import { getCollection } from "astro:content";

const statuses = [
  { value: "reading", label: "Reading" },
  { value: "read", label: "Read" },
  { value: "want", label: "Want to read" },
] as const;

const books = await getCollection("books");
const groups = statuses
  .map(({ value, label }) => ({
    label,
    books: books
      .filter(({ data }) => data.status === value)
      .sort((a, b) => (b.data.finishedDate?.getTime() ?? 0) - (a.data.finishedDate?.getTime() ?? 0)),
  }))
  .filter((group) => group.books.length > 0);
---

{groups.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  groups.map((group) => (
    <section class="space-y-3">
      <h2 class="font-serif text-xl font-semibold">{group.label}</h2>
      <ul class="space-y-3">
        {group.books.map(({ data }) => (
          <li>
            <Card
              class="space-y-1"
              href={data.link ?? undefined}
            >
              <CardHeader>
                <div>
                  <CardTitle>{data.title}</CardTitle>
                  <CardDescription>{data.author}</CardDescription>
                </div>
                <CardAction class="flex flex-col items-end gap-1 text-xs text-muted-foreground">
                  {data.rating && <Rating value={data.rating} />}
                  {data.finishedDate && <p>{formatMonthYear(data.finishedDate)}</p>}
                </CardAction>
              </CardHeader>
              {data.note && <CardContent class="text-muted-foreground">{data.note}</CardContent>}
            </Card>
          </li>
        ))}
      </ul>
    </section>
  ))
)}
