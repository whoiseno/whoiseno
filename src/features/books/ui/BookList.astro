---
import { Pagination } from "@/shared/ui/pagination";
import { Text } from "@/shared/ui/text";

import type { TypeBookPage } from "../api/books";
import BookItem from "./BookItem.astro";

interface Props {
  data: TypeBookPage;
}

const { page, pageCount, reading, library } = Astro.props.data;
const { pathname } = Astro.url;

const href = (target: number) => (target === 1 ? pathname : `${pathname}?page=${target}`);
---

{reading.length === 0 && library.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <>
    {reading.length > 0 && (
      <section class="space-y-s-m">
        <Text variant="heading">Reading</Text>
        <ul class="space-y-m">
          {reading.map((book) => (
            <li>
              <BookItem
                book={book}
                layout="row"
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    {library.length > 0 && (
      <section class="space-y-s-m">
        <Text variant="heading">Library</Text>
        {/* 14rem is the empty right-hand column of Site's body grid, so beside the rail the library widens into it. */}
        <div class="space-y-s-m rail:w-[calc(100%+14rem)]">
          <ul class="grid-fluid items-start gap-x-s gap-y-l [--grid-min:9.5rem]">
            {library.map((book) => (
              <li>
                <BookItem book={book} />
              </li>
            ))}
          </ul>
          <Pagination
            href={href}
            page={page}
            pageCount={pageCount}
          />
        </div>
      </section>
    )}
  </>
)}
