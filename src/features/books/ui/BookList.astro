---
import { formatMonthYear } from "@/shared/lib/date";
import { MediaItem } from "@/shared/ui/media-item";
import { Pagination } from "@/shared/ui/pagination";

import type { TypeBook, TypeBookPage } from "../api/books";

interface Props {
  data: TypeBookPage;
}

const { page, pageCount, reading, library } = Astro.props.data;
const { pathname } = Astro.url;

const href = (target: number) => (target === 1 ? pathname : `${pathname}?page=${target}`);

function timeline({ status, startedAt, finishedAt }: TypeBook) {
  if (status === "want") return "Want to read";
  if (status === "reading") return startedAt ? `Started ${formatMonthYear(startedAt)}` : "Reading";
  return finishedAt ? `Finished ${formatMonthYear(finishedAt)}` : undefined;
}
---

{reading.length === 0 && library.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <>
    {reading.length > 0 && (
      <section class="space-y-4">
        <h2 class="font-serif text-xl font-semibold">Reading</h2>
        <ul class="space-y-6">
          {reading.map((book) => (
            <li>
              <MediaItem
                byline={book.author}
                description={book.review}
                href={book.url}
                layout="row"
                poster={book.cover}
                rating={book.rating}
                timeline={timeline(book)}
                title={book.title}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    {library.length > 0 && (
      <section class="space-y-4">
        <h2 class="font-serif text-xl font-semibold">Library</h2>
        {/* 14rem is the empty right-hand column of Site's body grid, so from lg the library widens into it. */}
        <div class="space-y-4 lg:w-[calc(100%+14rem)]">
          <ul class="grid grid-cols-2 items-start gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
            {library.map((book) => (
              <li>
                <MediaItem
                  byline={book.author}
                  description={book.review}
                  href={book.url}
                  poster={book.cover}
                  rating={book.rating}
                  timeline={timeline(book)}
                  title={book.title}
                />
              </li>
            ))}
          </ul>
          <Pagination
            href={href}
            page={page}
            pageCount={pageCount}
          />
        </div>
      </section>
    )}
  </>
)}
