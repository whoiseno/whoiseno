---
import { resolveMediaLink } from "@/shared/config/media-sources";
import { formatMonthYear } from "@/shared/lib/date";
import MediaItem from "@/shared/ui/media-item/MediaItem.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const order = { reading: 0, read: 1, want: 2 } as const;

const books = (await getCollection("books")).sort(
  (a, b) =>
    order[a.data.status] - order[b.data.status] ||
    (b.data.finishedDate?.getTime() ?? 0) - (a.data.finishedDate?.getTime() ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);
const reading = books.filter(({ data }) => data.status === "reading");
const library = books.filter(({ data }) => data.status !== "reading");

function timeline({ status, startedDate, finishedDate }: CollectionEntry<"books">["data"]) {
  if (status === "want") return "Want to read";
  if (status === "reading") return startedDate ? `Started ${formatMonthYear(startedDate)}` : "Reading";
  return finishedDate ? `Finished ${formatMonthYear(finishedDate)}` : undefined;
}
---

{books.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <>
    {reading.length > 0 && (
      <section class="space-y-4">
        <h2 class="font-serif text-xl font-semibold">Reading</h2>
        <ul class="space-y-6">
          {reading.map(({ data }) => (
            <li>
              <MediaItem
                byline={data.author}
                description={data.description}
                layout="row"
                links={data.links.map(({ source, id }) => resolveMediaLink(source, id))}
                poster={data.poster}
                posterRatio={data.posterRatio}
                published={data.publishedDate}
                rating={data.rating}
                timeline={timeline(data)}
                title={data.title}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    {library.length > 0 && (
      <section class="space-y-4">
        <h2 class="font-serif text-xl font-semibold">Library</h2>
        <ul class="grid grid-cols-2 items-start gap-x-4 gap-y-8 sm:grid-cols-3">
          {library.map(({ data }) => (
            <li>
              <MediaItem
                byline={data.author}
                description={data.description}
                links={data.links.map(({ source, id }) => resolveMediaLink(source, id))}
                poster={data.poster}
                posterRatio={data.posterRatio}
                published={data.publishedDate}
                rating={data.rating}
                timeline={timeline(data)}
                title={data.title}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </>
)}
