---
import { formatDateRange } from "@/shared/lib/date";
import { Badge } from "@/shared/ui/badge";
import { Card, CardAction, CardDescription, CardFooter, CardHeader, CardTitle } from "@/shared/ui/card";
import { getCollection } from "astro:content";

interface Props {
  featured?: boolean;
  limit?: number;
}

const { featured = false, limit } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => !featured || data.featured))
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .slice(0, limit);
---

{projects.length === 0 ? (
  <p class="text-muted-foreground">Nothing here yet.</p>
) : (
  <ul class="space-y-3">
    {projects.map(({ id, data }) => (
      <li>
        <Card
          class="space-y-2"
          href={`/projects/${id}`}
        >
          <CardHeader>
            <CardTitle>{data.title}</CardTitle>
            <CardAction class="text-xs text-muted-foreground">
              {formatDateRange(data.startDate, data.endDate)}
            </CardAction>
          </CardHeader>
          <CardDescription>{data.description}</CardDescription>
          {data.skills.length > 0 && (
            <CardFooter>
              <ul class="flex flex-wrap gap-1.5">
                {data.skills.map((skill) => (
                  <li>
                    <Badge>{skill}</Badge>
                  </li>
                ))}
              </ul>
            </CardFooter>
          )}
        </Card>
      </li>
    ))}
  </ul>
)}
