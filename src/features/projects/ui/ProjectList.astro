---
import { Card, CardDescription, CardTitle } from "@/shared/ui/card";
import { Text } from "@/shared/ui/text";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

interface Props {
  featured?: boolean;
  limit?: number;
}

const { featured = false, limit } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => !featured || data.featured))
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .slice(0, limit);
---

{projects.length === 0 ? (
  <Text tone="muted">Nothing here yet.</Text>
) : (
  <ul class="grid-fluid gap-s-m [--grid-min:16rem]">
    {projects.map(({ id, data }) => (
      <li class="min-w-0">
        <Card
          class="group flex h-full flex-col gap-xs p-2xs"
          href={`/projects/${id}`}
        >
          <div class="flex aspect-video items-center justify-center overflow-hidden rounded-md border bg-muted">
            {data.logo ? (
              <Image
                class="h-12 w-auto max-w-3/5 object-contain transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none"
                alt=""
                src={data.logo}
              />
            ) : (
              <Text
                as="span"
                class="text-muted-foreground/40"
                aria-hidden="true"
                variant="display"
              >
                {data.title.charAt(0)}
              </Text>
            )}
          </div>
          <div class="space-y-3xs px-2xs pb-2xs">
            <CardTitle>{data.title}</CardTitle>
            <CardDescription class="line-clamp-2">{data.description}</CardDescription>
          </div>
        </Card>
      </li>
    ))}
  </ul>
)}
