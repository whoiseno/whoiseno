---
import { Icon } from "@/shared/ui/icon";
import { Text } from "@/shared/ui/text";

interface Props {
  title: string;
  href?: string;
  hrefLabel?: string;
}

const { title, href, hrefLabel = "View all" } = Astro.props;
---

<section
  data-slot="section"
  class="space-y-s-m"
>
  <div class="flex items-baseline justify-between gap-xs">
    <Text variant="heading">{title}</Text>
    {href && (
      <a
        class="inline-flex items-center gap-3xs text-muted-foreground transition-colors hover:text-foreground"
        href={href}
      >
        {hrefLabel}
        <Icon
          class="size-3.5"
          name="reicon:ArrowRight"
        />
      </a>
    )}
  </div>
  <slot />
</section>
