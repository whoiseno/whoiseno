---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  href?: string;
  hrefLabel?: string;
}

const { title, href, hrefLabel = "View all" } = Astro.props;
---

<section
  data-slot="section"
  data-reveal
  class="space-y-3"
  x-data
  x-intersect.once="$el.classList.add('in-view')"
>
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="font-serif text-xl font-semibold">{title}</h2>
    {href && (
      <a
        class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-foreground"
        href={href}
      >
        {hrefLabel}
        <Icon
          class="size-3.5"
          name="ph:arrow-right"
        />
      </a>
    )}
  </div>
  <slot />
</section>
