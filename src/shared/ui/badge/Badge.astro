---
import type { HTMLAttributes } from "astro/types";

import { badgeVariants, type TypeBadgeVariants } from "./variants";

interface Props extends HTMLAttributes<"span">, TypeBadgeVariants {}

const { variant, class: className, ...rest } = Astro.props;
---

<span
  data-slot="badge"
  data-variant={variant ?? "outline"}
  class={badgeVariants({ variant, class: className })}
  {...rest}
>
  {variant === "success" && (
    <span
      class="size-1.5 rounded-full bg-success motion-safe:animate-pulse"
      aria-hidden="true"
    />
  )}
  <slot />
</span>
