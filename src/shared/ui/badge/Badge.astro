---
interface Props {
  variant?: "outline" | "success";
  class?: string;
}

const { variant = "outline", class: className } = Astro.props;
---

<span
  data-slot="badge"
  data-variant={variant}
  class:list={[
    "inline-flex items-center gap-1.5 border px-1.5 py-0.5 text-xs whitespace-nowrap",
    variant === "outline" && "rounded-md text-muted-foreground",
    variant === "success" && "rounded-full border-success/30 bg-success/10 px-2 text-foreground",
    className,
  ]}
>
  {variant === "success" && (
    <span
      class="size-1.5 rounded-full bg-success"
      aria-hidden="true"
    />
  )}
  <slot />
</span>
