---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { cn } from "tailwind-variants";

interface Props {
  src?: ImageMetadata | null;
  name: string;
  class?: string;
}

const { src, name, class: className } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

{src ? (
  <Image
    data-slot="avatar"
    class={cn("size-16 rounded-full object-cover", className)}
    alt={name}
    height={128}
    src={src}
    width={128}
  />
) : (
  <div
    data-slot="avatar"
    class={cn(
      "flex size-16 items-center justify-center rounded-full bg-muted font-serif text-lg font-semibold",
      className,
    )}
    aria-label={name}
    role="img"
  >
    {initials}
  </div>
)}
