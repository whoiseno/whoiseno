---
import type { Polymorphic } from "astro/types";

import { getTextTag, textVariants, type TypeTextTag, type TypeTextVariants } from "./variants";

type Props<Tag extends TypeTextTag> = Polymorphic<{ as: Tag } & TypeTextVariants>;

const { as, variant = "body", tone, class: className, ...rest } = Astro.props;
const Tag = as ?? getTextTag(variant);
---

<Tag
  data-slot="text"
  data-variant={variant}
  class={textVariants({ variant, tone, class: className })}
  {...rest}
>
  <slot />
</Tag>
