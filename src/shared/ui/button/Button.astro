---
import type { HTMLAttributes } from "astro/types";

import { buttonVariants, type TypeButtonVariants } from "./variants";

interface Props extends Omit<HTMLAttributes<"button">, "color">, TypeButtonVariants {
  /** Renders an `<a>` styled as a button. External `http` links open in a new tab. */
  href?: string;
  loading?: string | boolean | null | undefined;
}

const { class: className, type, disabled, href, variant, color, size, loading = false, ...rest } = Astro.props;

const external = href?.startsWith("http");
const classes = buttonVariants({ variant, color, size, class: className });
---

{href ? (
  <a
    data-slot="button"
    data-cuelume-navigate
    data-cuelume-hover
    data-variant={variant ?? "solid"}
    data-color={color ?? "primary"}
    data-size={size ?? "md"}
    class={classes}
    href={href}
    rel={external ? "noopener noreferrer" : undefined}
    target={external ? "_blank" : undefined}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    data-slot="button"
    data-cuelume-tap
    data-cuelume-hover
    data-variant={variant ?? "solid"}
    data-color={color ?? "primary"}
    data-size={size ?? "md"}
    type={type}
    class={classes}
    disabled={disabled || loading}
    {...rest}
  >
    <slot />
  </button>
)}
