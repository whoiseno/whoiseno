---
import { getPlaceholder } from "@/shared/api/placeholders";
import { aspectRatioCatalog, type TypeAspectRatioName } from "@/shared/config/aspect-ratio";
import { formatDate } from "@/shared/lib/date";
import { Badge } from "@/shared/ui/badge";
import { Icon } from "@/shared/ui/icon";
import { Rating } from "@/shared/ui/rating";
import { Text, textVariants } from "@/shared/ui/text";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  /** Author, director or creator. */
  byline?: string;
  /** An imported image, or the URL of a remote cover. */
  poster?: ImageMetadata | string | null;
  /** The shape the poster is cropped to. */
  posterRatio?: TypeAspectRatioName;
  /** When the work itself came out. */
  published?: Date | null;
  /** Where the owner is with it, e.g. "Finished Jun 2025". */
  timeline?: string;
  rating?: number | null;
  /** The owner's own words about it. */
  description?: string;
  badge?: string;
  /** Attribution links to the catalogues the details came from. */
  links?: { name: string; href: string }[];
  /** Makes the poster a link to the work. */
  href?: string;
  /** `row` puts the poster beside the text, `card` stacks it on top. */
  layout?: "row" | "card";
}

const {
  title,
  byline,
  poster,
  posterRatio = "2/3",
  published,
  timeline,
  rating,
  description,
  badge,
  links = [],
  href,
  layout = "card",
} = Astro.props;
const row = layout === "row";
const posterShape = aspectRatioCatalog[posterRatio].ratio;
// A remote cover has no metadata to read a size from, so "Original" falls back to the usual cover shape for it.
const remoteShape = posterShape ?? 2 / 3;
// The size the poster is shown at in CSS pixels. `densities` adds the 2x and 3x files for sharper screens.
const posterWidth = row ? 112 : 200;
const posterImage = { alt: "", densities: [1, 2, 3], quality: 85, width: posterWidth };
// A blurred preview sits behind the poster, which fades in once it has loaded. Without JavaScript it shows at once.
const placeholder = typeof poster === "string" ? await getPlaceholder(poster) : null;
const posterClass = placeholder
  ? "relative w-full object-cover opacity-0 transition-opacity duration-500 data-loaded:opacity-100 [@media(scripting:none)]:opacity-100"
  : "w-full object-cover";
const posterOnLoad = placeholder ? "this.dataset.loaded = ''" : undefined;
const Poster = href ? "a" : "div";
const posterLink = href ? { href, "target": "_blank", "rel": "noopener noreferrer", "aria-label": title } : {};
---

<article
  data-slot="media-item"
  data-layout={layout}
  class:list={["flex", row ? "items-start gap-s" : "flex-col gap-xs"]}
>
  <Poster
    class={row ? "block w-[calc(var(--spacing-3xl)*7/6)] shrink-0 rounded-lg" : "block w-full rounded-lg"}
    {...posterLink}
  >
    {poster ? (
      <div class="relative overflow-hidden rounded-lg border bg-muted">
        {placeholder && (
          <div
            class="absolute inset-0 scale-110 bg-cover bg-center blur-xl"
            style={{ backgroundImage: `url(${placeholder})` }}
            aria-hidden="true"
          />
        )}
        {typeof poster === "string" ? (
          <Image
            {...posterImage}
            class={posterClass}
            height={Math.round(posterWidth / remoteShape)}
            onload={posterOnLoad}
            src={poster}
            style={{ aspectRatio: remoteShape }}
          />
        ) : (
          <Image
            {...posterImage}
            class={posterClass}
            height={posterShape ? Math.round(posterWidth / posterShape) : undefined}
            src={poster}
            style={{ aspectRatio: posterShape ?? undefined }}
          />
        )}
      </div>
    ) : (
      <div
        class:list={[
          "flex aspect-2/3 w-full items-center justify-center rounded-lg border bg-muted",
          textVariants({ variant: "display", tone: "muted" }),
        ]}
        aria-hidden="true"
      >
        {title[0]?.toUpperCase()}
      </div>
    )}
  </Poster>
  <div class="min-w-0 flex-1 space-y-2xs">
    <div class="space-y-3xs">
      <Text
        as="h3"
        variant="label"
      >
        {title}
      </Text>
      {byline && <Text tone="muted">{byline}</Text>}
    </div>
    {(badge || published) && (
      <Text
        as="div"
        class="flex flex-wrap items-center gap-x-2xs gap-y-3xs"
        tone="muted"
        variant="small"
      >
        {badge && <Badge>{badge}</Badge>}
        {published && <time datetime={published.toISOString()}>{formatDate(published)}</time>}
      </Text>
    )}
    {rating && <Rating value={rating} />}
    {timeline && (
      <Text
        tone="muted"
        variant="small"
      >
        {timeline}
      </Text>
    )}
    {description && <Text tone="faint">“{description}”</Text>}
    {links.length > 0 && (
      <ul class="flex flex-wrap gap-x-xs gap-y-3xs text-step--1">
        {links.map((link) => (
          <li>
            <a
              class="inline-flex items-center gap-3xs text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
              href={link.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              {link.name}
              <Icon
                class="size-3"
                name="reicon:ArrowUpRight"
              />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
