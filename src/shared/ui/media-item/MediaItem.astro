---
import type { HTMLAttributes } from "astro/types";

import { mediaItemVariants, type TypeMediaItemVariants } from "./variants";

interface Props extends HTMLAttributes<"article">, TypeMediaItemVariants {}

const { layout, class: className, ...rest } = Astro.props;
---

<article
  data-slot="media-item"
  data-layout={layout ?? "card"}
  class={mediaItemVariants({ layout, class: className })}
  {...rest}
>
  <slot />
</article>
