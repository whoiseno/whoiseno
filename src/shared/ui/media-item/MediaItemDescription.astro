---
import { Text } from "@/shared/ui/text";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"p"> {}

const { class: className, ...rest } = Astro.props;
---

<Text
  data-slot="media-item-description"
  class={className}
  tone="faint"
  {...rest}
>
  “<slot />”
</Text>
