---
import { Text } from "@/shared/ui/text";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h3"> {}

const { class: className, ...rest } = Astro.props;
---

<Text
  data-slot="media-item-title"
  as="h3"
  class={className}
  variant="label"
  {...rest}
>
  <slot />
</Text>
