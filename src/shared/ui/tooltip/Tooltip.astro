---
import { cn } from "@/shared/lib/tailwind";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  /** Milliseconds the pointer or focus has to stay on the trigger before the content shows. */
  delayDuration?: number;
}

const { delayDuration = 350, class: className, ...rest } = Astro.props;
---

<span
  data-slot="tooltip"
  class={cn("inline-flex", className)}
  x-data={`tooltip(${JSON.stringify({ delayDuration })})`}
  x-id="['tooltip']"
  {...rest}
>
  <slot />
</span>
