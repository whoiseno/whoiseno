---
import { siteName, type TypeNavItem } from "@/shared/config/site";
import Button from "@/shared/ui/button/Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  items: TypeNavItem[];
}

const { items } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  data-slot="site-header"
  class="sticky top-0 z-40 border-b bg-background/60 backdrop-blur"
  x-data="{ open: false }"
>
  <div class="mx-auto flex h-14 max-w-2xl items-center justify-between gap-4 px-4">
    <a
      class="font-serif font-semibold"
      href="/"
    >
      {siteName}
    </a>
    <div class="flex items-center gap-1">
      <nav
        class="hidden items-center md:flex"
        aria-label="Primary"
      >
        {items.map((item) => (
          <a
            class="rounded-md px-2.5 py-1.5 text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={isActive(item.href) ? "page" : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <slot name="actions" />
      <Button
        class="md:hidden"
        aria-label="Toggle menu"
        color="neutral"
        size="md"
        type="button"
        variant="ghost"
        x-bind:aria-expanded="open"
        x-on:click="open = !open"
      >
        <Icon
          name="ph:list"
          x-show="!open"
        />
        <Icon
          name="ph:x"
          x-cloak
          x-show="open"
        />
      </Button>
    </div>
  </div>
  <nav
    class="border-t md:hidden"
    aria-label="Mobile"
    x-cloak
    x-show="open"
  >
    <ul class="mx-auto max-w-2xl px-4 py-2">
      {items.map((item) => (
        <li>
          <a
            class="block py-2 text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={isActive(item.href) ? "page" : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
