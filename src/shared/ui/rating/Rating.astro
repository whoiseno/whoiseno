---
import { Icon } from "@/shared/ui/icon";

interface Props {
  value: number;
}

const { value } = Astro.props;
---

<span
  data-slot="rating"
  class="flex w-fit items-center gap-1 rounded-md bg-muted px-1.5 py-0.5 text-xs text-muted-foreground"
  aria-label={`${value} out of 5`}
  role="img"
>
  {value}/5
  <Icon
    class="size-3 text-rating"
    name="reicon:Star"
    weight="Filled"
  />
</span>
