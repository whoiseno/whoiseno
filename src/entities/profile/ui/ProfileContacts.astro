---
import { Avatar } from "@/shared/ui/avatar";
import { Button } from "@/shared/ui/button";
import { CopyButton } from "@/shared/ui/copy-button";
import { Icon } from "@/shared/ui/icon";
import { Popover, PopoverContent, PopoverTrigger } from "@/shared/ui/popover";
import { Text } from "@/shared/ui/text";
import { Image } from "astro:assets";

import type { TypeSocialLink } from "../model/types";

interface Props {
  socials: TypeSocialLink[];
}

const { socials } = Astro.props;
const email = socials.find((social) => social.email);
const links = socials.filter((social) => !social.email);
---

{socials.length > 0 && (
  <div
    data-slot="profile-contacts"
    class="flex flex-wrap items-center gap-2xs"
  >
    {email?.email && (
      <div class="inline-flex h-9 items-center rounded-lg border bg-card">
        <a
          class="px-xs transition-colors hover:text-muted-foreground"
          href={email.href}
        >
          {email.email}
        </a>
        <CopyButton
          class="h-full rounded-r-lg border-l px-2xs-xs hover:bg-muted"
          label="Copy email address"
          value={email.email}
        />
      </div>
    )}
    {links.map((social) => (
      <Popover hover>
        <PopoverTrigger
          class="flex size-9 items-center justify-center rounded-lg border bg-card transition-colors outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring"
          aria-label={social.label}
          href={social.href}
          rel="noopener noreferrer"
          target="_blank"
        >
          <Icon
            class="size-4.5"
            name={social.icon}
          />
        </PopoverTrigger>
        <PopoverContent
          class="w-80 overflow-hidden p-0"
          align="start"
        >
          <div class="h-20 bg-muted">
            {social.banner && (
              <Image
                class="size-full object-cover"
                alt=""
                height={160}
                src={social.banner}
                width={640}
              />
            )}
          </div>
          <div class="space-y-2xs px-s pb-s">
            <div class="-mt-8 flex items-end justify-between">
              <Avatar
                class="ring-4 ring-popover"
                name={social.displayName}
                src={social.avatar}
              />
              {social.actionLabel && (
                <Button
                  class="rounded-full"
                  href={social.href}
                  size="sm"
                >
                  {social.actionLabel}
                </Button>
              )}
            </div>
            <div>
              <Text
                class="flex items-center gap-3xs"
                variant="label"
              >
                {social.displayName}
                {social.verified && (
                  <Icon
                    class="size-4 text-info"
                    name="reicon:Verified"
                  />
                )}
              </Text>
              <Text tone="muted">{social.handle}</Text>
            </div>
            {social.bio && <Text>{social.bio}</Text>}
          </div>
        </PopoverContent>
      </Popover>
    ))}
  </div>
)}
