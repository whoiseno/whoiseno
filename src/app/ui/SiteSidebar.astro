---
import type { TypeNavItem } from "@/entities/navigation";
import { Avatar } from "@/shared/ui/avatar";
import type { ImageMetadata } from "astro";

import type { TypeCrumb } from "../model/types";
import {
  Sidebar,
  SidebarActions,
  SidebarMenu,
  SidebarMenuItem,
  SidebarMenuLink,
  SidebarMenuSub,
  SidebarMenuSubLink,
  SidebarNav,
  SidebarToc,
  SidebarTrigger,
} from "./sidebar";

interface Props {
  items: TypeNavItem[];
  owner: string;
  avatar?: ImageMetadata | null;
  /** Trail of the current page. Steps after the first nest under the nav link the trail starts from. */
  crumbs?: TypeCrumb[];
}

const { items, owner, avatar, crumbs = [] } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<Sidebar>
  <SidebarNav>
    <SidebarMenu>
      {items.map((item) => {
        const nested = crumbs[0]?.href === item.href ? crumbs.slice(1) : [];
        return (
          <SidebarMenuItem>
            <SidebarMenuLink
              aria-current={nested.length > 0 ? "true" : isActive(item.href) ? "page" : undefined}
              href={item.href}
            >
              {item.label}
            </SidebarMenuLink>
            {nested.length > 0 && (
              <SidebarMenuSub>
                {nested.map((crumb) => (
                  <SidebarMenuItem>
                    <SidebarMenuSubLink href={crumb.href}>{crumb.label}</SidebarMenuSubLink>
                  </SidebarMenuItem>
                ))}
              </SidebarMenuSub>
            )}
          </SidebarMenuItem>
        );
      })}
    </SidebarMenu>
  </SidebarNav>
  <SidebarToc>
    <slot name="toc" />
  </SidebarToc>
  <SidebarActions>
    <slot name="tools" />
    <slot name="actions" />
  </SidebarActions>
  <SidebarTrigger />
</Sidebar>
