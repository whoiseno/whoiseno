---
import { getNavItems } from "@/entities/navigation";
import { getProfile, getSocialLinks } from "@/entities/profile";
import { ScrollToTop } from "@/features/scroll-to-top";
import { SoundToggle } from "@/features/sound-toggle";
import { ThemeToggle } from "@/features/theme-toggle";
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
import { Tooltip, TooltipContent, TooltipTrigger } from "@/shared/ui/tooltip";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import type { TypeCrumb } from "../model/types";
import Root from "./Root.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteSidebar from "./SiteSidebar.astro";

interface Props {
  title?: string;
  description?: string;
  /** Trail shown above the title and nested under its nav link in the sidebar. */
  crumbs?: TypeCrumb[];
  /** Social preview image. Needs `site` in the Astro config to be emitted. */
  image?: ImageMetadata | null;
  imageAlt?: string;
  type?: "website" | "article";
}

const { title, description, crumbs, image, imageAlt, type } = Astro.props;
const profile = await getProfile();
const navItems = await getNavItems();
const previewImage =
  image && Astro.site ? new URL((await getImage({ src: image, width: 1200 })).src, Astro.site).href : undefined;
---

<Root
  description={description}
  image={previewImage}
  imageAlt={imageAlt}
  title={title}
  type={type}
>
  <div
    class="relative mx-auto w-full max-w-7xl flex-1 transition-[max-width] duration-300 in-data-wide:max-w-384 motion-reduce:transition-none rail:grid rail:grid-cols-[14rem_minmax(0,1fr)_14rem] [--page-width:100cqw]"
    data-slot="site-body"
  >
    <SiteSidebar
      avatar={profile.data.avatar}
      crumbs={crumbs}
      items={navItems}
      owner={profile.data.name}
    >
      <slot
        name="toc"
        slot="toc"
      />
      <slot
        name="tools"
        slot="tools"
      />
      <Fragment slot="actions">
        <ScrollToTop class="max-rail:hidden" />
        <ThemeToggle />
        {import.meta.env.DEV && (
          <Tooltip>
            <TooltipTrigger>
              <Button
                aria-label="Open the content editor"
                color="neutral"
                href="/keystatic"
                size="icon-md"
                variant="outline"
              >
                <Icon
                  class="size-4"
                  name="logo:keystatic"
                />
              </Button>
            </TooltipTrigger>
            <TooltipContent>Open the content editor (development only)</TooltipContent>
          </Tooltip>
        )}
        <SoundToggle />
      </Fragment>
    </SiteSidebar>
    <div
      class="@container min-w-0 pb-(--sidenotes-overflow,0px)"
      data-slot="site-content"
    >
      <main
        class="mx-auto w-full max-w-2xl space-y-xl px-s-l pt-xl pb-2xl-3xl transition-[max-width] duration-300 in-data-wide:max-w-4xl motion-reduce:transition-none"
        data-slot="site-main"
      >
        {title && (
          <SiteHeader
            crumbs={crumbs}
            description={description}
            title={title}
          >
            <slot name="header" />
          </SiteHeader>
        )}
        <slot />
      </main>
    </div>
    <slot name="sidenotes" />
  </div>
  <SiteFooter
    name={profile.data.name}
    socials={getSocialLinks(profile.data)}
  />
</Root>
