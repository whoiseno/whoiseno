---
import type { TypeSocialLink } from "@/entities/profile";
import { CopyButton } from "@/shared/ui/copy-button";
import { Icon } from "@/shared/ui/icon";

interface Props {
  name: string;
  socials: TypeSocialLink[];
}

const { name, socials } = Astro.props;
const year = new Date().getFullYear();
const [firstName] = name.split(" ");
---

<footer
  data-slot="site-footer"
  data-focus-hide
  class="border-t bg-muted/30 py-12"
>
  <div class="mx-auto max-w-2xl space-y-10 px-4">
    {socials.length > 0 && (
      <div class="space-y-6">
        <h2 class="font-serif text-2xl">
          Let's be friends{" "}
          <span
            class="text-success"
            aria-hidden="true"
          >
            ✦
          </span>
        </h2>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-3">
          {socials.map((social) => (
            <li class="min-w-0 space-y-0.5">
              {social.email ? (
                <>
                  <span class="flex items-center gap-1.5 font-medium">
                    {social.label}
                    <CopyButton
                      label="Copy email address"
                      value={social.email}
                    />
                  </span>
                  <a
                    class="block truncate text-muted-foreground transition-colors hover:text-foreground"
                    href={social.href}
                  >
                    {social.email}
                  </a>
                </>
              ) : (
                <a
                  class="group block"
                  href={social.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span class="flex items-center gap-1 font-medium">
                    {social.label}
                    <Icon
                      class="size-3.5 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      name="reicon:ArrowUpRight"
                    />
                  </span>
                  <span class="block truncate text-muted-foreground">{social.handle}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-xs text-muted-foreground">
        <p>
          &copy; {year} {name}
        </p>
        <p class="flex items-center gap-1">
          Made with
          <Icon
            class="size-3.5 text-error"
            name="reicon:Heart"
            weight="Filled"
          />
          <span class="sr-only">love</span>
          by {firstName}
        </p>
      </div>
      <p class="text-xs/relaxed text-muted-foreground/70">
        Built with Astro and Tailwind CSS, with Alpine.js for the small interactive parts. Pages are prerendered and
        deployed on Vercel, and posts are Markdoc files in the repository, edited through Keystatic. I chose static
        output and a little JavaScript over a client framework, and plain files in git over a database, so the site
        stays fast and easy to move. Code blocks use Expressive Code, math uses KaTeX, the code is organised with
        Feature-Sliced Design, and the type is Supreme, General Sans and Geist Mono.
      </p>
      <p class="text-xs/relaxed text-muted-foreground/70">
        Film and series posters come from
        <a
          class="underline underline-offset-4 transition-colors hover:text-foreground"
          href="https://www.themoviedb.org"
          rel="noopener noreferrer"
          target="_blank"
        >
          TMDB
        </a>
        . This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
    </div>
  </div>
</footer>
