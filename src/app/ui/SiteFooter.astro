---
import type { TypeSocialLink } from "@/entities/profile";

import SiteFooterColophon from "./SiteFooterColophon.astro";
import SiteFooterLegal from "./SiteFooterLegal.astro";
import SiteFooterSocials from "./SiteFooterSocials.astro";

interface Props {
  name: string;
  socials: TypeSocialLink[];
}

const { name, socials } = Astro.props;
---

<footer
  data-slot="site-footer"
  data-focus-hide
  class="border-t bg-muted/30 py-xl-2xl"
>
  <div class="mx-auto max-w-2xl space-y-xl px-s-l">
    <SiteFooterSocials socials={socials} />
    <div class="space-y-xs">
      <SiteFooterLegal name={name} />
      <SiteFooterColophon />
    </div>
  </div>
</footer>
