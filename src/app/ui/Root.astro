---
import { Font } from "astro:assets";

import { siteName } from "../config/site";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of the social preview image. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
}

const { title, description, image, imageAlt, type = "website" } = Astro.props;
---

<html
  class="scroll-smooth scrollbar-gutter-stable"
  lang="en"
>
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    {description && (
      <meta
        name="description"
        content={description}
      />
    )}
    <meta
      property="og:site_name"
      content={siteName}
    />
    <meta
      property="og:title"
      content={title ?? siteName}
    />
    <meta
      property="og:type"
      content={type}
    />
    {description && (
      <meta
        property="og:description"
        content={description}
      />
    )}
    {image && (
      <meta
        property="og:image"
        content={image}
      />
    )}
    {image && imageAlt && (
      <meta
        property="og:image:alt"
        content={imageAlt}
      />
    )}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
    <Font cssVariable="--font-general-sans-variable" />
    <Font cssVariable="--font-supreme-variable" />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body class="flex flex-col min-h-svh w-full overflow-x-clip *:w-full font-sans antialiased text-sm bg-background text-foreground">
    <slot />
  </body>
</html>
