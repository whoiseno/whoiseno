---
import { cn } from "@/shared/lib/tailwind";
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"button">, "color"> {}

const { class: className, ...rest } = Astro.props;
---

<Button
  data-slot="sidebar-trigger"
  class={cn("rail:hidden", className)}
  aria-label="Toggle menu"
  color="neutral"
  size="md"
  type="button"
  variant="ghost"
  x-bind:aria-controls="$id('sidebar-nav')"
  x-bind:aria-expanded="open"
  x-on:click="toggle()"
  {...rest}
>
  <Icon
    name="reicon:Menu"
    x-show="!open"
  />
  <Icon
    name="reicon:X"
    x-cloak
    x-show="open"
  />
</Button>
