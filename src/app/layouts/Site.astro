---
import { getNavItems } from "@/entities/navigation";
import { getProfile } from "@/entities/profile/getProfile";
import { getSocialLinks } from "@/entities/profile/socials";
import { ThemeToggle } from "@/features/theme-toggle";
import { Button } from "@/shared/ui/button";
import Root from "@/shared/ui/layouts/Root.astro";
import SiteFooter from "@/shared/ui/site/SiteFooter.astro";
import SiteHeader from "@/shared/ui/site/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getProfile();
const navItems = await getNavItems();
---

<Root title={title}>
  <SiteHeader items={navItems}>
    <Fragment slot="actions">
      {import.meta.env.DEV && (
        <Button
          color="neutral"
          href="/keystatic"
          size="sm"
          variant="outline"
        >
          CMS
        </Button>
      )}
      <ThemeToggle />
    </Fragment>
  </SiteHeader>
  <main
    class="mx-auto max-w-2xl flex-1 space-y-10 px-4 pt-8 pb-16 transition-[max-width] duration-300 in-data-[wide]:max-w-4xl motion-reduce:transition-none"
    data-slot="site-main"
  >
    {title && (
      <header class="space-y-1">
        <h1 class="font-serif text-2xl font-bold">{title}</h1>
        {description && <p class="text-muted-foreground">{description}</p>}
        <slot name="header" />
      </header>
    )}
    <slot />
  </main>
  <SiteFooter
    name={profile.data.name}
    socials={getSocialLinks(profile.data)}
  />
</Root>
