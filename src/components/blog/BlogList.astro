---
import { ArrowRightIcon } from "@phosphor-icons/react";
import BlogPostCard from "./BlogPostCard.astro";
import Divider from "@/components/Divider.astro";
import { getCollection } from "astro:content";
import { formatDate } from "@/utils/formats.ts";
import Link from "@/components/Link.astro";

const blog = (
	await getCollection("blog", ({ data }) => {
		return import.meta.env.PROD ? data.isPublished !== false : true;
	})
)
	.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf())
	.slice(0, 3);
---

<div class="mt-6 space-y-6">
  {
    blog.length >= 1 ? (
      <ul class="space-y-8">
    {
      blog.map((post) => (
        <li>
          <BlogPostCard
            date={formatDate(post.data.createdAt)}
            title={post.data.title}
            href={`/blog/${post.id}`}
          />
        </li>
      ))
    }
  </ul>
  <Divider>
    <Link
      href="/blog"
      >Read more<ArrowRightIcon
        className="size-4"
        weight="fill"
      />
      </Link>
  </Divider>
    ) : (
      <p class="text-accent font-medium">No blog has been published</p>
    )
  }
</div>
