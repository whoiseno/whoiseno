---
import { cn } from "@/utils/cn";
import { capitalize } from "@/utils/formats";
import { Icon } from "astro-icon/components";
import { cva, type VariantProps } from "class-variance-authority";

const calloutConfig = {
  note: {
    style: "ring-blue-100 hover:ring-blue-300",
    textColor: "text-blue-600",
    icon: "ph:info-fill",
  },
  tip: {
    style: "ring-green-100 hover:ring-green-300",
    textColor: "text-green-600",
    icon: "ph:lightbulb-fill",
  },
  warning: {
    style: "ring-amber-100 hover:ring-amber-300",
    textColor: "text-amber-600",
    icon: "ph:warning-fill",
  },
  danger: {
    style: "ring-red-100 hover:ring-red-300",
    textColor: "text-red-600",
    icon: "ph:x-circle-fill",
  },
  important: {
    style: "ring-purple-100 hover:ring-purple-300",
    textColor: "text-purple-600",
    icon: "ph:trophy-fill",
  },
} as const;

const calloutVariants = cva("relative my-6 rounded-md text-sm ring-2 bg-card text-card-foreground", {
  variants: {
    variant: Object.fromEntries(Object.entries(calloutConfig).map(([key, config]) => [key, config.style])),
  },
  defaultVariants: {
    variant: "note",
  },
});

interface Props extends VariantProps<typeof calloutVariants> {
  title?: string;
  variant: keyof typeof calloutConfig;
  defaultOpen: boolean;
}

const { title, variant = "note", defaultOpen = true, ...props } = Astro.props;
---

<details
  class={cn(
    calloutVariants({ variant }),
    "details [&[open]>summary_svg:last-child]:rotate-180"
  )}
  {...props}
  open={defaultOpen}
>
  <summary class="px-4 py-3 flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden">
    <Icon
      name={calloutConfig[variant].icon}
      class={cn("me-2 size-5 shrink-0", calloutConfig[variant].textColor)}
    />
    <span class={cn("font-medium me-2", calloutConfig[variant].textColor)}>
      {capitalize(variant)}
      {title && <span class="font-normal opacity-70"> ({title})</span>}
    </span>
    <Icon
      name="ph:caret-down-fill"
      class={cn(
        "ms-auto size-4 shrink-0 transition-transform duration-250",
        calloutConfig[variant].textColor
      )}
    />
  </summary>
  <div class="px-4 pb-4">
    <slot />
  </div>
</details>

<style>
  .details::details-content {
    display: block;
    block-size: 0;
    overflow: hidden;
    transition-property: block-size, content-visibility;
    transition-duration: 250ms;
    transition-behavior: allow-discrete;
    transition-timing-function: ease-out;
  }

  .details[open]::details-content {
    /* Fallback for browsers that don't support calc-size() function */
    block-size: auto;

    /* calc-size() function allows transition to height: auto; */
    block-size: calc-size(auto, size);
  }
</style>
