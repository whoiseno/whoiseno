---
// biome-ignore lint/style/useImportType: usage as type & value
import { Code } from "astro-expressive-code/components";
import type { ComponentProps } from "astro/types";

type FrameTypes = ComponentProps<typeof Code>["frame"];

interface Props {
	content: string;
	language?: string;
	title?: string;
	frame?: FrameTypes;
}

const { content, language, title, frame } = Astro.props;
---

<Code
  code={content}
  lang={language}
  title={title}
  frame={frame}
/>
