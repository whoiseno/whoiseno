---
import Link from "@/components/Link.astro";
import { Theme } from "@/components/ui/theme.tsx";

const pathname = new URL(Astro.request.url).pathname;

interface LinkProps {
	label: string;
	href: `/${string}`;
}

const links: Array<LinkProps> = [
  	{
	  label: "Home",
	  href: "/",
	},
	{
	  label: "Works",
	  href: "/works",
	},
	{
		label: "Blog",
		href: "/blog",
	},
	{
	  label: "About",
	  href: "/about",
	},
];
---

<nav class="sticky top-0 z-6">
  <div class="flex items-center justify-between">
    <Link
      href="/"
      class="text-lg font-semibold px-0"
    >
      enoabasi &mdash; essien
    </Link>
    <div class="flex items-center gap-x-px">
      {
        links.map((link) => {
          const isActive = link.href === pathname;
          return (
            <Link
              href={link.href}
              class:list={{
                "underline underline-offset-10 decoration-4 decoration-blue-500": isActive,
              }}
            >
              {link.label}
            </Link>
          );
        })
      }
      <Theme client:load />
    </div>
  </div>
</nav>
