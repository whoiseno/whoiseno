---
import Link from "@/components/Link.astro";
import { Theme } from "@/components/ui/theme.tsx";

const pathname = new URL(Astro.request.url).pathname;

interface LinkProps {
	label: string;
	href: `/${string}`;
}

const links: Array<LinkProps> = [
	// {
	//   label: "Works",
	//   href: "/works",
	// },
	{
		label: "Blog",
		href: "/blog",
	},
	// {
	//   label: "About",
	//   href: "/about",
	// },
	// {
	//   label: "Contact",
	//   href: "/contact",
	// },
];
---

<nav class="fixed top-0 z-20 inset-x-0">
  <div class="max-w-4xl mx-auto px-4 py-2 flex items-center justify-between">
    <Link
      href="/"
      class="text-lg lg:text-2xl font-semibold"
    >
      enoabasi &mdash; essien
    </Link>
    <div class="flex items-center gap-x-px">
      {
        links.map((link) => {
          const isActive = link.href === pathname;
          return (
            <Link
              href={link.href}
              class:list={{
                "underline underline-offset-2 decoration-4 decoration-blue-500": isActive,
              }}
            >
              {link.label}
            </Link>
          );
        })
      }
      <Theme client:load />
    </div>
  </div>
</nav>
