---
import { MailboxIcon, LinkedinLogoIcon, GithubLogoIcon, XLogoIcon, type Icon } from "@phosphor-icons/react";

import Link from "@/components/Link.astro";
import { ButtonGroup, ButtonGroupSeparator } from "@/components/ui/button-group";
import Copy from "@/components/widgets/Copy.astro";

interface SocialProps {
	label: string;
	href: string | URL;
	icon: Icon;
}

const socials: Array<SocialProps> = [
	{
		label: "Twitter",
		href: "https://twitter.com/enoiscooked",
		icon: XLogoIcon,
	},
	{
		label: "GitHub",
		href: "https://github.com/whoiseno",
		icon: GithubLogoIcon,
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/enoabasi-essien/",
		icon: LinkedinLogoIcon,
	},
];
---

<ul class="mt-4 flex gap-x-2 items-center">
  {
    socials.map((social) => (
      <li>
        <Link
          href={social.href}
          target={"_blank"}
          variant={"secondary"}
          size={"lg"}
          class={"text-base"}
        >
          <social.icon
            className="size-5"
            weight="fill"
          />
          {social.label}
        </Link>
      </li>
    ))
  }
  <li>
    <ButtonGroup>
      <Link
        href={"mailto:humanwhodreams@gmail.com"}
        variant={"secondary"}
        size={"lg"}
      >
        <MailboxIcon
          className="size-5"
          weight="fill"
        />
        humanwhodreams@gmail.com</Link
      >
      <ButtonGroupSeparator />
      <Copy
        textToCopy="humanwhodreams@gmail.com"
        size={"icon-lg"}
      />
    </ButtonGroup>
  </li>
</ul>
