---
import { ArrowUpRightIcon } from "@phosphor-icons/react";

import BlogList from "@/components/blog/BlogList.astro";
import Root from "@/layouts/Root.astro";

const title = "Home - Whoiseno?";
const description = "Discover the bits and pieces about myself, what makes me tick, and more.";
---

<Root
  title={title}
  description={description}
  class="space-y-24"
>
  <section>
    <h2 class="scroll-m-20 pb-2 text-3xl font-semibold tracking-tight first:mt-0">Introduction</h2>
    <p class="leading-7 not-first:mt-6">
      Hey I'm Enoabasi, known as the pseudonym <span class="font-semibold">whoiseno?</span> &mdash; a
      software developer, and self-taught product designer who loves crafting thoughtful, user-centered,
      and visually appealing interfaces. I am currently based in <a
        class="link link--underline text-base px-0"
        href="https://w.wiki/FsTX"
        target="_blank"
        >Abuja<ArrowUpRightIcon weight="fill" /><a
          >, Nigeria. On my free time, I'm building <span class="font-semibold">✱✱✱✱✱✱✱✱</span>
        </a>
      </a>
    </p>
  </section>
  <section>
    <h2 class="scroll-m-20 pb-2 text-3xl font-semibold tracking-tight first:mt-0">Blog</h2>
    <p class="leading-7 not-first:mt-6">Articles, journals, and think pieces of my journey.</p>
    <BlogList />
  </section>
</Root>
