---
import Site from "@/app/layouts/Site.astro";
import ProfileHero from "@/entities/profile/ProfileHero.astro";
import { ProjectList } from "@/features/projects";
import { WorkList } from "@/features/works";
import Section from "@/shared/ui/section/Section.astro";
---

<Site>
  <ProfileHero />
  <Section
    href="/works"
    title="Work Experiences"
  >
    <WorkList limit={3} />
  </Section>
  <Section
    href="/projects"
    title="Projects"
  >
    <ProjectList
      limit={3}
      featured
    />
  </Section>
</Site>
