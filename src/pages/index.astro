  >
  </div>
  <div class="flex-1 flex items-center justify-center">
    <hgroup class="text-center space-y-4 pt-0 p-12">
      <h1 class="font-serif text-2xl font-bold leading-none">Welcome to My Portfolio</h1>
      <p class="uppercase">The portfolio of Enoabasi Essien &mdash; Coming soon</p>
    </hgroup>
  </div>
</RootLayout>
