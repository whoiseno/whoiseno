---
import Root from "@/layouts/Root.astro";
import Socials from "./_components/landing/Socials.astro";
import Intro from "./_components/landing/Intro.astro";
import Footer from "@/components/Footer.astro";

const title = "enoabasi essien";
const description =
  "A software developer, and product designer who loves crafting thoughtful, user-centered, and visually appealing interfaces.";
---

<Root
  title={title}
  description={description}
>
  <main class="space-y-10">
    <Intro />
    <Socials />
  </main>
  <Footer />
</Root>
