---
import Root from "@/layouts/Root.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/utils/cn";
import Socials from "@/components/Socials.astro";

const title = "enoabasi essien";
const description =
	"A software developer, and product designer who loves crafting thoughtful, user-centered, and visually appealing interfaces.";
---

<Root
  title={title}
  description={description}
  class="max-section-gap"
>
  <section>
    <h2 class="scroll-m-20 pb-2 text-4xl md:text-6xl font-bold tracking-tight first:mt-0 text-primary">
      Design. Build. Ship
    </h2>
    <p class="leading-7 not-first:mt-6">
      Hey I'm <span class="font-semibold">Enoabasi Essien</span>.
    </p>
    <p class="leading-7 not-first:mt-6">
      A software developer, and product designer who loves crafting thoughtful, <br />user-centered,
      and visually appealing interfaces.
    </p>
    <p class="leading-7 not-first:mt-6">
      I am currently based in <a
        class={cn(buttonVariants({ variant: "link", class: "text-base px-0 gap-x-px" }))}
        href="https://w.wiki/FsTX"
        target="_blank"
        >Abuja
      </a>.
    </p>
  </section>
  <section>
    <h2 class="scroll-m-20 pb-2 text-3xl font-semibold tracking-tight first:mt-0">
      Reach out to me on
    </h2>
    <p class="leading-7 not-first:mt-6">
      Hey I'm active on these channels incase you wanna reach out to me.
    </p>
    <Socials />
  </section>
</Root>
