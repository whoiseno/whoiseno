    <Section>
      <h1 class="font-semibold">enoabasi &mdash; essien</h1>
      <div class="flex items-center gap-x-8">
        <a
          href="/works"
          class="button button--tertiary"
          >Works</a
        >
        <a
          href="/blog"
          class="button button--tertiary"
          >Blog</a
        >
        <a
          href="/about"
          class="button button--tertiary"
          >About</a
        >
        <a
          href="/contact"
          class="button button--tertiary"
          >Contact</a
        >
      </div>
    </Section>
  </main>
</RootLayout>
