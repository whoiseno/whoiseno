---
import Site from "@/app/layouts/Site.astro";
import ProfileHero from "@/entities/profile/ProfileHero.astro";
import ProjectList from "@/features/projects/ProjectList.astro";
import WorkList from "@/features/works/WorkList.astro";
import Section from "@/shared/ui/section/Section.astro";
---

<Site>
  <ProfileHero />
  <Section
    href="/works"
    title="Works"
  >
    <WorkList limit={3} />
  </Section>
  <Section
    href="/projects"
    title="Projects"
  >
    <ProjectList
      limit={3}
      featured
    />
  </Section>
</Site>
