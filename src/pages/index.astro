---
import { Site } from "@/app/ui";
import { ProfileHero } from "@/entities/profile";
import { ProjectList } from "@/features/projects";
import { WorkList } from "@/features/works";
import { Section } from "@/shared/ui/section";
---

<Site>
  <ProfileHero />
  <Section
    href="/works"
    title="Work Experiences"
  >
    <WorkList limit={3} />
  </Section>
  <Section
    href="/projects"
    title="Projects"
  >
    <ProjectList
      limit={4}
      featured
    />
  </Section>
</Site>
