---
import Site from "@/app/layouts/Site.astro";
import { getWritingTags } from "@/entities/writing/getWritingTags";
import { WritingFilters, WritingList } from "@/features/writing";
import Icon from "@/shared/ui/icon/Icon.astro";
import type { InferGetStaticPropsType } from "astro";

export async function getStaticPaths() {
  const tags = await getWritingTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.props;
---

<Site
  description={`${tag.count} ${tag.count === 1 ? "post" : "posts"} tagged "${tag.label}".`}
  title={`Writing / ${tag.label}`}
>
  <WritingFilters
    slot="header"
    tag={tag.slug}
  />
  <WritingList tag={tag.slug} />
  <a
    class="inline-flex items-center gap-1 text-muted-foreground transition-colors hover:text-foreground"
    href="/writing"
  >
    <Icon
      class="size-3.5"
      name="reicon:ArrowLeft"
    />
    All writing
  </a>
</Site>
