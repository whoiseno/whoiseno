---
import { Site } from "@/app/ui";
import {
  Figure,
  WritingBackLink,
  writingKindLabels,
  WritingPager,
  WritingToc,
  WritingToolbar,
} from "@/features/writing";
import { formatDate } from "@/shared/lib/date";
import { Badge } from "@/shared/ui/badge";
import { Button } from "@/shared/ui/button";
import { Icon } from "@/shared/ui/icon";
import { Prose } from "@/shared/ui/prose";
import type { InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("writing")).sort(
    (a, b) => a.data.publishedDate.getTime() - b.data.publishedDate.getTime(),
  );
  const toLink = (entry?: (typeof entries)[number]) => (entry ? { id: entry.id, title: entry.data.title } : null);
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: toLink(entries[index - 1]), next: toLink(entries[index + 1]) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, previous, next } = Astro.props;
const { title, kind, description, publishedDate, cover, coverAlt } = entry.data;
const { Content, headings } = await render(entry);
---

<Site
  crumbs={[{ label: "Writing", href: "/writing" }, { label: title }]}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  title={title}
  type="article"
>
  <WritingToc
    slot="toc"
    headings={headings}
  />
  <WritingToolbar
    slot="tools"
    class="max-lg:hidden"
    size="icon-md"
  />
  {cover && (
    <div
      slot="header"
      class="pt-3"
    >
      <Figure
        alt={coverAlt}
        priority
        src={cover}
      />
    </div>
  )}
  <div
    class="space-y-10"
    x-data
    x-on:keydown.escape.window="$store.writingReader.setFocus(false)"
  >
    <Button
      class="fixed top-4 right-4 z-50 opacity-50 hover:opacity-100 focus-visible:opacity-100"
      aria-label="Exit focus mode"
      color="neutral"
      size="sm"
      type="button"
      variant="ghost"
      x-cloak
      x-on:click="$store.writingReader.setFocus(false)"
      x-show="$store.writingReader.focus"
      x-transition:enter="animate-in duration-300 fade-in"
      x-transition:leave="animate-out duration-300 fade-out"
    >
      <Icon name="reicon:X" />
    </Button>
    <div
      class="flex items-center justify-between gap-3"
      data-focus-hide
    >
      <div class="flex items-center gap-3 text-xs text-muted-foreground">
        <Badge>{writingKindLabels[kind]}</Badge>
        <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
      </div>
      <WritingToolbar class="lg:hidden" />
    </div>
    <Prose>
      <Content />
    </Prose>
    <div
      class="space-y-4"
      data-focus-hide
    >
      <WritingBackLink class="lg:hidden" />
      <WritingPager
        next={next}
        previous={previous}
      />
    </div>
  </div>
</Site>
