---
import { Site } from "@/app/ui";
import {
  Figure,
  WritingBackLink,
  writingKindLabels,
  WritingPager,
  WritingReader,
  WritingSidenotes,
  WritingToc,
  WritingToolbar,
} from "@/features/writing";
import { formatDate } from "@/shared/lib/date";
import { Badge } from "@/shared/ui/badge";
import { Prose } from "@/shared/ui/prose";
import { Text } from "@/shared/ui/text";
import type { InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("writing")).sort(
    (a, b) => a.data.publishedDate.getTime() - b.data.publishedDate.getTime(),
  );
  const toLink = (entry?: (typeof entries)[number]) =>
    entry ? { href: `/writing/${entry.id}`, title: entry.data.title } : null;
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: toLink(entries[index - 1]), next: toLink(entries[index + 1]) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, previous, next } = Astro.props;
const { title, kind, description, publishedDate, cover, coverAlt } = entry.data;
const { Content, headings } = await render(entry);
---

<Site
  crumbs={[{ label: "Writing", href: "/writing" }, { label: title }]}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  title={title}
  type="article"
>
  <WritingToc
    slot="toc"
    headings={headings}
  />
  <WritingSidenotes slot="sidenotes" />
  <WritingToolbar
    slot="tools"
    class="max-rail:hidden"
    size="icon-md"
  />
  {cover && (
    <div
      slot="header"
      class="pt-xs"
    >
      <Figure
        alt={coverAlt}
        priority
        src={cover}
      />
    </div>
  )}
  <WritingReader>
    <div
      class="flex items-center justify-between gap-xs"
      data-focus-hide
    >
      <Text
        as="div"
        class="flex items-center gap-xs"
        tone="muted"
        variant="small"
      >
        <Badge>{writingKindLabels[kind]}</Badge>
        <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
      </Text>
      <WritingToolbar class="rail:hidden" />
    </div>
    <Prose>
      <Content />
    </Prose>
    <div
      class="space-y-s-m"
      data-focus-hide
    >
      <WritingBackLink class="rail:hidden" />
      <WritingPager
        next={next}
        previous={previous}
      />
    </div>
  </WritingReader>
</Site>
