---
import Root from "@/layouts/Root.astro";

import { getAllWorks } from "@/data/works";
import { formatDate } from "@/utils/formats";

const works = await getAllWorks();

const title = "Works";
const description = "Projects, side projects, and experiments through out my journey.";
---

<Root
  title={title}
  description={description}
>
  <main class="space-y-10">
    <hgroup>
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight first:mt-0">Works</h1>
      <p class="leading-7 not-first:mt-4 text-muted-foreground text-lg">
        Projects, side projects, and experiments through out my journey.
      </p>
    </hgroup>
    <section>
      {
        works.length > 0 ?
          <ul class="grid gap-y-4">
            {works.map(async (work) => {
              return (
                <li class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                  <a
                    href={`/works/${work.id}`}
                    class="text-lg leading-snug font-semibold underline underline-offset-2 decoration-2 decoration-muted-foreground/50 hover:decoration-primary"
                  >
                    {work.data.title}
                  </a>
                  <time
                    datetime={work.data.createdAt.toString()}
                    class="text-sm font-semibold text-muted-foreground"
                  >
                    {formatDate(work.data.createdAt)}
                  </time>
                </li>
              );
            })}
          </ul>
        : <div class="flex items-center justify-center px-10 py-20">
            <p class="font-medium">No works have been published</p>
          </div>
      }
    </section>
  </main>
</Root>
