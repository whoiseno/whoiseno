---
import { Site } from "@/app/ui";
import { formatDateRange } from "@/shared/lib/date";
import { Badge } from "@/shared/ui/badge";
import { Icon } from "@/shared/ui/icon";
import { Prose } from "@/shared/ui/prose";
import { Text } from "@/shared/ui/text";
import type { InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { title, description, startDate, endDate, skills, demoLink, sourceLink } = project.data;
const { Content } = await render(project);
const links = [
  { label: "Live demo", href: demoLink },
  { label: "Source", href: sourceLink },
].filter((link) => link.href);
---

<Site
  crumbs={[{ label: "Projects", href: "/projects" }, { label: title }]}
  description={description}
  title={title}
>
  <div class="space-y-xs">
    <Text
      as="div"
      class="flex flex-wrap items-center gap-x-s gap-y-2xs"
      tone="muted"
      variant="small"
    >
      <p>{formatDateRange(startDate, endDate)}</p>
      {links.map((link) => (
        <a
          class="inline-flex items-center gap-3xs transition-colors hover:text-foreground"
          href={link.href}
          rel="noopener noreferrer"
          target="_blank"
        >
          {link.label}
          <Icon
            class="size-3.5"
            name="reicon:ArrowUpRight"
          />
        </a>
      ))}
    </Text>
    {skills.length > 0 && (
      <ul class="flex flex-wrap gap-2xs">
        {skills.map((skill) => (
          <li>
            <Badge>{skill}</Badge>
          </li>
        ))}
      </ul>
    )}
  </div>
  <Prose>
    <Content />
  </Prose>
  <a
    class="inline-flex items-center gap-3xs text-muted-foreground transition-colors hover:text-foreground"
    href="/projects"
  >
    <Icon
      class="size-3.5"
      name="reicon:ArrowLeft"
    />
    All projects
  </a>
</Site>
