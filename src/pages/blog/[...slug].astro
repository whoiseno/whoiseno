---
import { render } from "astro:content";
import Root from "@/layouts/Root.astro";
import Prose from "@/components/Prose.astro";
import Link from "@/components/Link.astro";
import { ArrowLeftIcon } from "@phosphor-icons/react";
import ScrollToTop from "@/components/widgets/ScrollToTop.astro";
import Copy from "@/components/widgets/Copy.astro";
import { getAllPosts } from "@/data/posts";
import Callout from "@/components/content/Callout.astro";
import Fence from "@/components/content/Fence.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const permalink = new URL(Astro.url.pathname, Astro.url.origin).href.replace(/\/+$/, "");

const { post } = Astro.props;
const { Content } = await render(post);
---

<Root
  title={post.data.title}
  description={post.data.summary}
>
  <header class="flex items-center justify-between mb-12">
    <Link
      href="/blog"
      variant="secondary"
      size="icon-lg"
      class="rounded-full"
    >
      <ArrowLeftIcon />
      <span class="sr-only">blog</span>
    </Link>
    <Copy
      textToCopy={permalink}
      size="icon-lg"
      className="rounded-full"
    />
  </header>
  <Prose>
    <hgroup class="text-center">
      <h1 transition:name={`title_${post.data.title}`}>
        {post.data.title}
      </h1>
      <p>{post.data.summary}</p>
      <div class="text-lg text-muted-foreground my-6">•••</div>
    </hgroup>
    <Content
      components={{
        Callout: Callout,
        Fence: Fence,
        /* TODO: Insert custom components here  */
      }}
    />
  </Prose>
  <ScrollToTop />
</Root>
