---
import { render } from "astro:content";
import Root from "@/layouts/Root.astro";
import Prose from "@/components/Prose.astro";
import ScrollToTop from "@/components/widgets/ScrollToTop.astro";
import { getAllPosts } from "@/data/posts";
import Callout from "@/components/content/Callout.astro";
import Mark from "@/components/content/Mark.astro";
import ImageViewer from "@/components/widgets/ImageViewer.astro";
import Header from "./_components/Header.astro";
import Headline from "./_components/Headline.astro";
import Footer from "./_components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const permalink = new URL(Astro.url.pathname, Astro.url.origin).href.replace(/\/+$/, "");

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Root
  title={post.data.title}
  description={post.data.summary}
>
  <main>
    <Header permalink={permalink} />
    <Headline
      title={post.data.title}
      summary={post.data.summary}
    />
    <Prose>
      <Content
        components={{
          Callout: Callout,
          Mark: Mark,
        }}
      />
      <Footer date={post.data.createdAt} />
    </Prose>
    <ScrollToTop />
    <ImageViewer />
  </main>
</Root>
</style>
