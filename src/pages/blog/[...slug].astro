---
export const prerender = false;

import { render } from "astro:content";

import Root from "@/layouts/Root.astro";
import Prose from "@/components/Prose.astro";
import { getBlogById } from "@/data/blog";
import Link from "@/components/Link.astro";
import { ArrowLeftIcon } from "@phosphor-icons/react";
import ScrollToTop from "@/components/widgets/ScrollToTop.astro";
import Copy from "@/components/widgets/Copy.astro";

const { slug } = Astro.params;

if (slug === undefined) {
  return Astro.redirect("/404");
}

const post = await getBlogById(slug);

if (post === undefined) {
  return Astro.redirect("/404");
}

const permalink = new URL(Astro.url.pathname, Astro.url.origin).href.replace(/\/+$/, "");

const { Content } = await render(post);
---

<Root
  title={post.data.title}
  description={post.data.summary}
>
  <header class="flex items-center justify-between mb-12">
    <Link
      href="/blog"
      variant="secondary"
      size="icon-lg"
      class="rounded-full"
    >
      <ArrowLeftIcon />
      <span class="sr-only">blog</span>
    </Link>
    <Copy
      textToCopy={permalink}
      size="icon-lg"
      className="rounded-full"
    />
  </header>
  <Prose>
    <hgroup class="text-center">
      <h1 transition:name={`title_${post.data.title}`}>
        {post.data.title}
      </h1>
      <p>{post.data.summary}</p>
      <div class="text-lg text-muted-foreground my-6">•••</div>
    </hgroup>
    <Content class="prose prose-stone" />
  </Prose>
  <ScrollToTop />
</Root>
