---
import Root from "@/layouts/Root.astro";
import { formatDate } from "@/utils/formats";
import { getAllBlogs } from "@/data/blog";
import { Card, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { cn } from "@/utils/cn";
import { buttonVariants } from "@/components/ui/button";

const blogs = await getAllBlogs();

const title = "Blog";
const description = "Articles, journals, and think pieces of my journey.";
---

<Root
  title={title}
  description={description}
  class="max-section-gap"
>
  <hgroup>
    <h1 class="font-semibold text-3xl">Blog</h1>
    <p class="leading-7 not-first:mt-6">Articles, journals, and think pieces of my journey.</p>
  </hgroup>
  <section>
    <div>
      {
        blogs.length > 0 ?
          <div class="space-y-10">
            <ul class="space-y-4">
              {blogs.map(async (blog) => {
                return (
                  <li>
                    <Card>
                      <CardHeader>
                        <CardTitle>
                          <a
                            href={`/blog/${blog.id}`}
                            class={cn(
                              buttonVariants({
                                variant: "secondary-ghost",
                                size: "sm",
                                class: "hover:text-primary text-base -ms-3",
                              })
                            )}
                            transition:name={`title_${blog.data.title}`}
                          >
                            {blog.data.title}
                          </a>
                        </CardTitle>
                        <CardDescription className="line-clamp-1">
                          {blog.data.summary}
                        </CardDescription>
                      </CardHeader>
                      <CardFooter>
                        <p class="text-muted-foreground font-medium">
                          {formatDate(blog.data.createdAt)}
                        </p>
                      </CardFooter>
                    </Card>
                  </li>
                );
              })}
            </ul>
            <blockquote class="text-sm text-muted-foreground text-center">
              "The only true wisdom is in knowing you know nothing." - Socrates
            </blockquote>
          </div>
        : <p class="font-medium">No blog posts has been published</p>
      }
    </div>
  </section>
</Root>
