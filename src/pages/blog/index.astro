---
import Section from "@/components/Section.astro";
import Root from "@/layouts/Root.astro";

import { getCollection } from "astro:content";

const blog = (
  await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? data.isPublished !== false : true;
  })
).sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const title = "Blog - Whoiseno?";
const description = "Articles, journals, and think pieces of my journey.";
---

<Root
  title={title}
  description={description}
>
  <Section>
    <h1 class="font-semibold text-3xl">enoabasi &mdash; essien</h1>
    <p class="pt-7 text-lg">Currently rebuilding my portfolio &mdash; Blog page.</p>
  </Section>
  <Section>
    <ul class="mt-8">
      {
        blog.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </Section>
</Root>
