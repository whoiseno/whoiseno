---
import BlogPostCard from "@/components/blog/BlogPostCard.astro";
import Divider from "@/components/Divider.astro";
import Root from "@/layouts/Root.astro";
import { formatDate } from "@/utils/formats";
import { ArrowRightIcon } from "@phosphor-icons/react";

import { getCollection } from "astro:content";

const blog = (
	await getCollection("blog", ({ data }) => {
		return import.meta.env.PROD ? data.isPublished !== false : true;
	})
).sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());

const title = "Blog - Whoiseno?";
const description = "Articles, journals, and think pieces of my journey.";
---

<Root
  title={title}
  description={description}
>
  <section class="ds-content">
    <div>
      <h1 class="font-semibold text-3xl">Blog</h1>
      <p class="leading-7 not-first:mt-6">Articles, journals, and think pieces of my journey.</p>
    </div>
    <div class="mt-6 space-y-6">
      {
        blog.length >= 1 ?
          <ul class="space-y-8">
            {blog.map((post) => (
              <li>
                <BlogPostCard
                  date={formatDate(post.data.createdAt)}
                  title={post.data.title}
                  href={`/blog/${post.id}`}
                />
              </li>
            ))}
          </ul>
        : <p class="text-accent font-medium">No blog has been published</p>
      }
    </div>
  </section>
</Root>
