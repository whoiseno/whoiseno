---
import Root from "@/layouts/Root.astro";
import { formatDate } from "@/utils/formats";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { getAllPosts } from "@/data/posts";

const posts = await getAllPosts();

const title = "Blog";
const description = "Articles, journals, and think pieces of my journey.";
---

<Root
  title={title}
  description={description}
>
  <main class="max-w-5xl mx-auto space-y-10">
    <hgroup>
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight first:mt-0">Blog</h1>
      <p class="leading-7 not-first:mt-4 text-muted-foreground text-lg">
        Articles, journals, and think pieces of my journey.
      </p>
    </hgroup>
    <section>
      {
        posts.length > 0 ?
          <div class="grid grid-cols-1 gap-y-8">
            <ul class="grid gap-y-4 list-disc">
              {posts.map(async (post) => {
                return (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="text-base leading-snug font-semibold underline underline-offset-2 decoration-2 decoration-muted-foreground/50 hover:decoration-primary"
                    >
                      {post.data.title}.
                    </a>
                  </li>
                );
              })}
            </ul>
            <blockquote class="text-sm text-muted-foreground text-center font-medium">
              "The only true wisdom is in knowing you know nothing." - Socrates
            </blockquote>
          </div>
        : <div class="flex items-center justify-center px-10 py-20">
            <p class="font-medium">No blog posts has been published</p>
          </div>
      }
    </section>
  </main>
</Root>
