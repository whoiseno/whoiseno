---
interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<hgroup class="text-left">
  <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight first:mt-0">
    {title}
  </h1>
  <p class="leading-7 not-first:mt-4 text-muted-foreground text-lg">{summary}</p>
  <div class="flex items-center justify-center my-6">
    <span class="text-lg text-muted-foreground">•••</span>
  </div>
</hgroup>
