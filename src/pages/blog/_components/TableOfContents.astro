---
import { buttonVariants } from "@/components/ui/button";
import type { TocItem } from "@/utils/generate-toc";

interface Props {
  heading: TocItem;
}

const { heading } = Astro.props;
---

<li class="ms-4">
  <a
    href={"#" + heading.slug}
    class={buttonVariants({ variant: "ghost", size: "xs", class: "text-muted-foreground" })}
    >{heading.text}</a
  >
  {
    heading.children.length > 0 && (
      <ul>
        {heading.children.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
